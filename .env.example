# Solo frontend environment variables
#
# IMPORTANT: this is a TEMPLATE only. The real .env file is gitignored
# (see .gitignore). The real values live in Vercel project env vars
# (https://vercel.com/bevanjboyle-5401s-projects/solo-path/settings/environment-variables).
# For local development, copy this to .env and fill in the values from
# Vercel or from Supabase Settings > API.
#
# DO NOT commit a real .env to the repo. Lovable's bot has a history of
# overwriting .env with the wrong project ID (a Lovable demo Supabase
# rather than your real one), which silently breaks production. Vercel
# env vars take precedence over .env, so set them there to be safe.
#
# Correct project ID: dnnxmjazillhktwttkux
# Wrong (Lovable demo) project ID to watch out for: ofvnwacxyhtcyhygttie

VITE_SUPABASE_PROJECT_ID="dnnxmjazillhktwttkux"
VITE_SUPABASE_URL="https://dnnxmjazillhktwttkux.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="REPLACE_WITH_KEY_FROM_SUPABASE_DASHBOARD_SETTINGS_API"
