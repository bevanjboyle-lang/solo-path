{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://dnnxmjazillhktwttkux.supabase.co/functions/v1/sitemap" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ]
}
